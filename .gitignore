# ==============================================================================
# SEOSONA Video - STANDARD .GITIGNORE
# ==============================================================================

# 1. Hệ sinh thái Python (Tự động tải qua pip / uv)
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage

# 2. Hệ sinh thái Node.js (Tự động tải qua npm install)
node_modules/
dist/
build/
.npm/

# 3. Môi trường hệ điều hành & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.antigravity/
.gemini/
.codex/
.env

# 4. Trí nhớ & Database cục bộ (Tự động tạo mới/Index lại)
3_MEMORY/
!3_MEMORY/.gitkeep
video_os.db
chroma_db/
*.sqlite3

# 5. Model AI & Weights cục bộ (Tự động tải khi code chạy)
# Models nằm trong thư mục kỹ năng hoặc thư mục assets
*.pt
*.pth
*.safetensors
*.onnx
*.bin
huggingface/
checkpoints/
models/

# 6. Không gian làm việc & File Render (Rác / Kết quả sinh ra)
8_WORKSPACE/
!8_WORKSPACE/.gitkeep
.temp/
SRT_temp/
*.mp4
*.webm
*.mov
*.wav
*.mp3

# Required production media contracts. Render outputs stay ignored, but these
# stable input assets must survive a fresh checkout.
!7_ASSETS/voice_profiles/
!7_ASSETS/voice_profiles/*.wav
!7_ASSETS/bgm/
!7_ASSETS/bgm/**/*.mp3
!7_ASSETS/sfx/
!7_ASSETS/sfx/**/*.wav
!7_ASSETS/video_templates/
!7_ASSETS/video_templates/**/
!7_ASSETS/video_templates/**/assets/*.mp3
!7_ASSETS/video_templates/**/assets/*.wav

# 7. Knowledge Base (Kho cào dữ liệu lớn)
# Chỉ giữ lại script, bỏ qua các dữ liệu raw đã cào
2_KNOWLEDGE/repos/
!2_KNOWLEDGE/repos/.gitkeep

# 8. Framework & Tooling (Trình duyệt headless, app build)
# Ví dụ playwright browsers tự động tải
.playwright/
