7_ASSETS/templates/**/snapshots/
7_ASSETS/templates/**/compiled/

# Runtime inbox + backup snapshots
0_INPUT_INBOX/
*_BACKUP/


# Vendored HyperFrames monorepo source (reference only; render uses the npm/local
# hyperframes binary, not this checkout). Kept on disk, out of git — EXCEPT registry/,
# which is the runtime block library (hf_blocks/block_picker/native_composer._overlay_blocks
# read it). Tracking it makes a fresh clone able to render the 97 blocks.
5_FRAMEWORK/hf_engine/*
!5_FRAMEWORK/hf_engine/registry/
# but NOT registry/examples — demo compositions hf_blocks never renders (it uses blocks/ + components/)
5_FRAMEWORK/hf_engine/registry/examples/

# archived non-video research notes (kept local, not in git)
_QUARANTINE/research_archive/

# external toolkits cloned for reference/training (VieNeu finetune, etc.) — local only
2_KNOWLEDGE/external_toolkits/

# voice training workspace (datasets, LoRA adapters, checkpoints) — large, local only
