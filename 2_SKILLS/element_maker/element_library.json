{
  "_doc": "SEOSONA element library — on-brand visual elements rendered to transparent PNG by 2_SKILLS/element_maker/element_maker.py (Playwright HTML->PNG), composited over footage by talking_head_edit (spec key \"elements\") and embeddable by the faceless engine. LIGHT brand only; icons = vendored Lucide (7_ASSETS/brand/icons), tinted to a semantic ROLE.",
  "roles": {
    "emphasis": "#2A5BDA",
    "success": "#16A34A",
    "danger": "#E2724D",
    "caution": "#D97706",
    "info": "#3A4A6B",
    "baseline": "#94A3B8"
  },
  "types": {
    "icon_tile": {
      "desc": "glassy rounded tile + line-icon + optional corner badge + label (the core reel motif)",
      "params": {
        "icon": "concept or lucide name",
        "role": "emphasis|success|danger|caution|info|baseline",
        "badge": "check|x|warn|q|star or a number string (optional)",
        "label": "optional text under the tile"
      }
    },
    "chip": {
      "desc": "rounded pill: icon + text (tag/label)",
      "params": {
        "icon": "optional",
        "role": "..",
        "label": "text"
      }
    },
    "badge": {
      "desc": "standalone big circle badge",
      "params": {
        "kind": "check|x|warn|q|star",
        "role": "optional override"
      }
    },
    "emoji": {
      "desc": "native colour emoji (functional punctuation)",
      "params": {
        "name": "concept alias",
        "char": "or a raw emoji"
      }
    },
    "sparkle": {
      "desc": "4-point star glint",
      "params": {
        "role": ".."
      }
    },
    "arrow": {
      "desc": "hand-drawn dashed curved arrow",
      "params": {
        "role": ".."
      }
    },
    "ring": {
      "desc": "proof highlight ring (rounded-rect dashed stroke)",
      "params": {
        "role": "..",
        "w": "px",
        "h": "px"
      }
    },
    "big_stat": {
      "desc": "big number/stat pop",
      "params": {
        "role": "..",
        "value": "big text",
        "label": "sub"
      }
    },
    "tile3d": {
      "desc": "glossy pseudo-3D app-tile (iso-cube look) + line-icon + label",
      "params": {
        "icon": "concept/lucide",
        "role": "..",
        "label": "opt"
      }
    },
    "phone": {
      "desc": "phone bezel, optionally wrapping a screenshot",
      "params": {
        "src": "optional image path"
      }
    },
    "bracket": {
      "desc": "HUD corner brackets around a region",
      "params": {
        "role": "..",
        "w": "px",
        "h": "px"
      }
    },
    "marker": {
      "desc": "marker highlight-swipe bar behind bold text",
      "params": {
        "role": "..",
        "label": "text"
      }
    },
    "count_up": {
      "desc": "a number counting 0→value (native effect, rich_motion)",
      "params": {
        "value": "number",
        "prefix": "opt",
        "suffix": "opt",
        "role": "..",
        "label": "opt"
      }
    },
    "lottie": {
      "desc": "a LottieFiles motion-graphic (rich_motion) → transparent animated clip",
      "params": {
        "src": "lottie name or concept alias",
        "w": "px",
        "h": "px"
      }
    },
    "confetti": {
      "desc": "celebration burst (native effect, rich_motion)",
      "params": {
        "count": "opt"
      }
    },
    "kinetic": {
      "desc": "word-by-word pop-in text",
      "params": {
        "text": "..",
        "keyword": "opt",
        "role": ".."
      }
    },
    "pulse_ring": {
      "desc": "attention ring pulse",
      "params": {
        "role": ".."
      }
    },
    "progress_bar": {
      "desc": "bar filling 0→value%",
      "params": {
        "value": "0-100",
        "label": "opt",
        "role": ".."
      }
    }
  },
  "placement": "In talking_head_edit spec: \"elements\":[{ \"type\":.., ..params.., \"t\":sec, \"dur\":sec, \"x\":px, \"y\":px, \"w\":targetWidthPx(optional) }]. Rendered PNG fades in at t and out at t+dur; place in the top band or beside the face, never over the mouth.",
