# ==========================================
# SEOSONA VIDEO FACTORY - SECRETS & KEYS
# ==========================================

# 1. CORE APIs
OPENAI_API_KEY=""          # cloud LLM fallback for script-writing after Gemini 429 (llm_engine)
GEMINI_API_KEY=""          # primary free-tier LLM (Flash models)
PEXELS_API_KEY=""

# 2. SCRAPING & AUTOMATION (New Tools)
FIRECRAWL_API_KEY=""
CRAWL4AI_API_TOKEN=""
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""

# 2b. GITHUB — make_video fetches real repo metadata via `gh api` (auth = 5000 req/hr vs 60)
GITHUB_TOKEN=""

# 2c. HUGGING FACE — downloads the CORE voice model OmniVoice (k2-fsa). huggingface_hub reads HF_TOKEN.
HF_TOKEN=""
HUGGINGFACE_TOKEN=""

# 3. YOUTUBE & CLOUD
YOUTUBE_DATA_API_KEY=""
YOUTUBE_OAUTH_FILE=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
PAGESPEED_API_KEY=""       # real Core Web Vitals as grounded facts for SEO videos (optional)

# 3b. SCRIPT-WRITING LLM CASCADE (real LLMs only; deterministic template is the LAST resort)
# Order = Gemini → Z.ai GLM (free cloud) → OpenAI → Ollama (local/free) → Claude. More set = less deterministic.
GEMINI_API_KEY_2=""                  # extra Gemini keys — auto-rotated on 429 to multiply free quota
GEMINI_API_KEY_3=""                  # (add up to _10, or a comma list in GEMINI_API_KEYS)
ZAI_API_KEY=""                       # Z.ai GLM free tier (get at z.ai; real-name verify, ~1 QPS)
SEOSONA_ZAI_MODEL="glm-4.5-flash"    # free GLM model (or glm-4.7-flash)
ANTHROPIC_API_KEY=""                 # "bạn" tier — dormant until set
SEOSONA_ANTHROPIC_MODEL="claude-sonnet-5"
SEOSONA_OLLAMA_MODEL="gemma3:12b"    # local free floor — keeps a natural-language model always on
SEOSONA_REQUIRE_LLM=""               # "1" = abort instead of deterministic if ALL real LLMs fail

# 4. PUBLISH DESTINATIONS (social + cloud) — see 1_CONFIG/credentials/*.example.json
TIKTOK_ACCESS_TOKEN=""
FB_PAGE_TOKEN=""
FB_PAGE_ID=""
GDRIVE_SERVICE_ACCOUNT_FILE=""
GDRIVE_FOLDER_ID=""

# 5. REMOTE CONTROL (Telegram)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 3c. NVIDIA NIM (free tier) — LLM cascade fallback (Llama-3.3-70B) + FLUX image-gen. ~40 RPM, finite credits.
NVIDIA_API_KEY=""
SEOSONA_NVIDIA_MODEL="meta/llama-3.3-70b-instruct"
# Pixabay — free stock B-roll video + music (broll_sourcer)
PIXABAY_API_KEY=""
