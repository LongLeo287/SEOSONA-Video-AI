<!DOCTYPE html>
<html lang="vi" data-composition-variables='[
  {"id":"DURATION","type":"number","label":"Duration","default":96},
  {"id":"N1_START","type":"number","label":"Node 1 Start","default":2},
  {"id":"N2_START","type":"number","label":"Node 2 Start","default":10},
  {"id":"N3_START","type":"number","label":"Node 3 Start","default":25},
  {"id":"N4_START","type":"number","label":"Node 4 Start","default":40},
  {"id":"N5_START","type":"number","label":"Node 5 Start","default":55},
  {"id":"N6_START","type":"number","label":"Node 6 Start","default":65},
  {"id":"N7_START","type":"number","label":"Node 7 Start","default":75},
  {"id":"N8_START","type":"number","label":"Node 8 Start","default":85}
]'>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1080, height=1920">
<title>SEOSONA Loop Flow - 3D Cinematic</title>
<script src="./node_modules/gsap/dist/gsap.min.js"></script>
<script src="./node_modules/gsap/dist/MotionPathPlugin.min.js"></script>
<link rel="stylesheet" href="./node_modules/@fontsource/be-vietnam-pro/index.css">
<style>
:root {
  --bg-core:       #0A0B14;
  --bg-deep:       #06060A;
  
  --c-cyan:        #40E0D0;
  --c-yellow:      #FFDF00;
  --c-magenta:     #FF007A;
  --c-purple:      #8A2BE2;
  --c-green:       #00FF88;
  
  --text-main:     #FFFFFF;
  --text-dim:      #8C92A6;
  --text-label:    #B0B8CC;
  
  --font-body:     'Be Vietnam Pro', sans-serif;
  --font-mono:     'Courier New', monospace;
}

html, body {
  margin: 0; padding: 0; width: 1080px; height: 1920px; overflow: hidden;
  font-family: var(--font-body); background-color: var(--bg-deep); color: var(--text-main);
  perspective: 2000px; /* 3D Perspective! */
}

#root {
  position: relative; width: 1080px; height: 1920px; overflow: hidden;
  background: radial-gradient(circle at 50% 50%, var(--bg-core) 0%, var(--bg-deep) 100%);
  transform-style: preserve-3d;
}

/* Background Stars */
.star-layer {
  position: absolute; top: -1500px; left: -1500px; width: 3px; height: 3px; border-radius: 50%;
  background: transparent; z-index: 0; pointer-events: none;
  transform: translateZ(-800px); /* Push stars deep into the background */
}

/* HUD Overlay */
.hud-layer { position: absolute; inset: 0; z-index: 100; pointer-events: none; }
.hud-text {
  position: absolute; font-size: 24px; font-weight: 700; letter-spacing: 3px;
  color: var(--text-label); text-transform: uppercase;
}
.hud-tl { top: 90px; left: 80px; }
.hud-tr { top: 90px; right: 80px; }
.hud-bl { bottom: 180px; left: 80px; }
.hud-br { bottom: 180px; right: 80px; }

/* Logo */
.logo-watermark {
  position: absolute; top: 180px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 16px; opacity: 0.3;
}
.logo-icon {
  width: 50px; height: 50px; border-radius: 50%; border: 3px solid #FFF;
  position: relative; display: flex; justify-content: center; align-items: center;
}
.logo-icon::after { content: ''; width: 24px; height: 24px; border: 3px solid #FFF; border-radius: 12px 12px 12px 0; transform: rotate(45deg); }
.logo-text { font-size: 24px; font-weight: 500; letter-spacing: 4px; color: #FFF; }

/* 3D Camera and Path */
#camera-container {
  position: absolute; top: 0; left: 0; width: 13000px; height: 3000px; z-index: 5;
  transform-style: preserve-3d;
}

.path-svg {
  position: absolute; top: 0; left: 0; width: 13000px; height: 3000px; z-index: 1; pointer-events: none;
  transform: translateZ(-10px);
}
.path-dotted { fill: none; stroke: rgba(255,255,255,0.25); stroke-width: 6; stroke-dasharray: 20 24; stroke-linecap: round; filter: drop-shadow(0 0 10px rgba(255,255,255,0.2)); }
.path-hidden { fill: none; stroke: none; }
.path-diamond { fill: var(--bg-deep); stroke: rgba(255,255,255,0.6); stroke-width: 4; }

/* Tracker Dot */
#tracker {
  position: absolute; width: 32px; height: 32px; background: var(--c-cyan); border-radius: 50%;
  box-shadow: 0 0 60px 20px var(--c-cyan); z-index: 50; transform: translate(-50%, -50%);
  top: 0; left: 0;
}

/* Base Nodes */
.node { position: absolute; z-index: 10; transform-style: preserve-3d; }

/* Node 1: Huge typography */
.n1-num {
  position: absolute; left: 240px; top: 1200px; width: 120px; height: 120px; background: var(--c-cyan);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 48px; font-weight: 900; color: var(--bg-core); z-index: 20;
}
.ui-text-left {
  position: absolute; left: 240px; top: 1360px; width: 900px; text-align: left; z-index: 20;
}
.ui-sub { font-size: 32px; font-weight: 800; letter-spacing: 6px; text-transform: uppercase; margin-bottom: 20px; color: var(--c-cyan); }
.ui-title { font-size: 110px; font-weight: 900; line-height: 1.05; letter-spacing: -2px; margin-bottom: 30px; color: #fff; text-shadow: 0 0 40px rgba(255,255,255,0.2); }
.ui-desc { font-size: 36px; font-weight: 400; color: var(--text-label); line-height: 1.6; letter-spacing: 1px; }

/* Generic Glass Cards for standard nodes */
.ui-glass-card {
  position: absolute; left: -300px; top: -350px; width: 1000px;
  background: rgba(12, 10, 24, 0.7); border: 2px solid rgba(255,255,255,0.1);
  border-radius: 40px; padding: 80px; box-shadow: 0 50px 120px rgba(0,0,0,0.9);
  backdrop-filter: blur(50px); box-sizing: border-box; text-align: left;
}
.n-num {
  position: absolute; left: -30px; top: -60px; width: 140px; height: 140px;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 56px; font-weight: 900; color: #FFF;
}
.gc-sub { font-size: 28px; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 20px; }
.gc-title { font-size: 72px; font-weight: 900; color: #fff; letter-spacing: -1px; margin-bottom: 60px; line-height: 1.1; }
.gc-col { background: rgba(5,5,10,0.6); border-radius: 24px; padding: 40px; text-align: left; border: 1px solid rgba(255,255,255,0.05); }
.gc-col-desc { font-size: 32px; font-weight: 700; color: #fff; line-height: 1.5; }

/* Subtitle & Progress */
.progress-container { position: absolute; bottom: 0; left: 0; right: 0; height: 8px; background: rgba(255,255,255,0.05); z-index: 9999; }
.progress-bar { height: 100%; width: 0%; background: var(--c-cyan); box-shadow: 0 0 15px var(--c-cyan); }

/* Registry Block Containers */
.registry-block {
  position: absolute; left: -400px; top: -400px;
}
</style>
</head>
<body>
<div id="root" data-composition-id="main" data-start="0" data-duration="96" data-width="1080" data-height="1920">

  <!-- Background Stars -->
  <div class="star-layer" id="stars"></div>

  <!-- HUD Overlay -->
  <div class="hud-layer">
    <div class="hud-text hud-tl">SPATIAL FLOW</div>
    <div class="hud-text hud-tr">08 ĐIỂM NỘI DUNG</div>
    <div class="logo-watermark">
      <div class="logo-icon"></div>
      <div class="logo-watermark">BrandName</div>
    </div>
  </div>

  <div id="camera-container">
    <svg class="path-svg" viewBox="0 0 13000 3000" xmlns="http://www.w3.org/2000/svg">
      <!-- Hidden path for GSAP tracking -->
      <path id="p1" class="path-hidden" d="M 1000 1500 C 1750 1500, 1750 2000, 2500 2000" />
      <path id="p2" class="path-hidden" d="M 2500 2000 C 3250 2000, 3250 1200, 4000 1200" />
      <path id="p3" class="path-hidden" d="M 4000 1200 C 4750 1200, 4750 2000, 5500 2000" />
      <path id="p4" class="path-hidden" d="M 5500 2000 C 6250 2000, 6250 1200, 7000 1200" />
      <path id="p5" class="path-hidden" d="M 7000 1200 C 7750 1200, 7750 2000, 8500 2000" />
      <path id="p6" class="path-hidden" d="M 8500 2000 C 9250 2000, 9250 1200, 10000 1200" />
      <path id="p7" class="path-hidden" d="M 10000 1200 C 10750 1200, 10750 2000, 11500 2000" />

      <!-- Visible path intersecting everything -->
      <path class="path-dotted" d="M -500 1500 L 1000 1500 C 1750 1500, 1750 2000, 2500 2000 C 3250 2000, 3250 1200, 4000 1200 C 4750 1200, 4750 2000, 5500 2000 C 6250 2000, 6250 1200, 7000 1200 C 7750 1200, 7750 2000, 8500 2000 C 9250 2000, 9250 1200, 10000 1200 C 10750 1200, 10750 2000, 11500 2000" />
      
      <!-- Diamonds -->
      <rect class="path-diamond" x="1726" y="1726" width="48" height="48" transform="rotate(45 1750 1750)" />
      <rect class="path-diamond" x="3226" y="1576" width="48" height="48" transform="rotate(45 3250 1600)" />
      <rect class="path-diamond" x="4726" y="1576" width="48" height="48" transform="rotate(45 4750 1600)" />
      <rect class="path-diamond" x="6226" y="1576" width="48" height="48" transform="rotate(45 6250 1600)" />
      <rect class="path-diamond" x="7726" y="1576" width="48" height="48" transform="rotate(45 7750 1600)" />
      <rect class="path-diamond" x="9226" y="1576" width="48" height="48" transform="rotate(45 9250 1600)" />
      <rect class="path-diamond" x="10726" y="1576" width="48" height="48" transform="rotate(45 10750 1600)" />
    </svg>

    <!-- The Tracker glow dot -->
    <div id="tracker"></div>

    <!-- NODE 1: Pure HTML Cinematic -->
    <div class="node clip" id="n1" style="left: 0px; top: 0px; transform: translateZ(200px);" data-start="0" data-duration="20" data-track-index="1">
      <div class="n1-num">01</div>
      <div class="ui-text-left">
        <div class="ui-sub">META MỚI CỦA AI</div>
        <div class="ui-title">LOOP<br>ENGINEERING</div>
        <div class="ui-desc">Từ vận hành · Tự kiểm tra · Tự sửa sai</div>
      </div>
    </div>
    


    <!-- NODE 2: Flowchart Vertical (Hyperframes Registry Block) -->
    <div class="node" id="n2" style="left: 2500px; top: 2000px; transform: translateZ(-200px) rotateY(-15deg);">
      <div class="n-num" style="background: var(--c-purple); box-shadow: 0 0 60px rgba(138,43,226,0.6); z-index: 100; left: -100px; top: -100px;">02</div>
      <div class="registry-block">
        <div data-composition-src="compositions/flowchart-vertical.html" data-composition-id="flowchart-vertical" data-duration="20" data-width="1920" data-height="1080" style="transform: scale(0.65); transform-origin: top left; border-radius: 40px; overflow: hidden; box-shadow: 0 50px 150px rgba(0,0,0,0.9);"></div>
      </div>
    </div>

    <!-- NODE 3: Standard Card -->
    <div class="node" id="n3" style="left: 4000px; top: 1200px; transform: translateZ(100px) rotateY(10deg);">
      <div class="ui-glass-card">
        <div class="n-num" style="background: var(--c-yellow); color: #000; box-shadow: 0 0 60px rgba(255,223,0,0.6);">03</div>
        <div class="gc-sub" style="color: var(--c-yellow);">THÀNH PHẦN</div>
        <div class="gc-title">Nodes & Edges</div>
        <div class="gc-col"><div class="gc-col-desc">Cấu trúc đồ thị cho phép rẽ nhánh phức tạp.</div></div>
      </div>
    </div>

    <!-- NODE 4: Code 3D Extrude (Hyperframes Registry Block) -->
    <div class="node" id="n4" style="left: 5500px; top: 2000px; transform: translateZ(-300px) rotateY(-20deg);">
      <div class="n-num" style="background: var(--c-magenta); box-shadow: 0 0 60px rgba(255,0,122,0.6); z-index: 100; left: -100px; top: -100px;">04</div>
      <div class="registry-block">
        <div data-composition-src="compositions/code-3d-extrude.html" data-composition-id="code-3d-extrude" data-duration="20" data-width="1920" data-height="1080" style="transform: scale(0.65); transform-origin: top left; border-radius: 40px; overflow: hidden; box-shadow: 0 50px 150px rgba(0,0,0,0.9);"></div>
      </div>
    </div>

    <!-- NODE 5: VFX Liquid Glass (Hyperframes Registry Block) -->
    <div class="node" id="n5" style="left: 7000px; top: 1200px; transform: translateZ(250px) rotateY(15deg);">
      <div class="n-num" style="background: var(--c-cyan); box-shadow: 0 0 60px rgba(64,224,208,0.6); z-index: 100; left: -100px; top: -100px; color: #000;">05</div>
      <div class="registry-block">
        <div data-composition-src="compositions/vfx-liquid-glass.html" data-composition-id="liquid-glass" data-duration="20" data-width="1920" data-height="1080" style="transform: scale(0.65); transform-origin: top left; border-radius: 40px; overflow: hidden; box-shadow: 0 50px 150px rgba(0,0,0,0.9);"></div>
      </div>
    </div>

    <!-- NODE 6 -->
    <div class="node" id="n6" style="left: 8500px; top: 2000px; transform: translateZ(-100px) rotateY(-10deg);">
      <div class="ui-glass-card">
        <div class="n-num" style="background: var(--c-purple); box-shadow: 0 0 60px rgba(138,43,226,0.6);">06</div>
        <div class="gc-sub" style="color: var(--c-purple);">KIẾN TRÚC THỰC CHIẾN</div>
        <div class="gc-title">LANGGRAPH & MCP</div>
        <div class="gc-col"><div class="gc-col-desc">Biến loop thành kiến trúc. Phối hợp nhiều luồng quan sát và kiểm chứng.</div></div>
      </div>
    </div>

    <!-- NODE 7 -->
    <div class="node" id="n7" style="left: 10000px; top: 1200px; transform: translateZ(150px) rotateY(10deg);">
      <div class="ui-glass-card">
        <div class="n-num" style="background: var(--c-yellow); color: #000; box-shadow: 0 0 60px rgba(255,223,0,0.6);">07</div>
        <div class="gc-sub" style="color: var(--c-yellow);">KỸ NĂNG QUAN TRỌNG</div>
        <div class="gc-title">BIẾT KHI NÀO ĐÃ ĐỦ</div>
        <div class="gc-col"><div class="gc-col-desc">AI cần khả năng tự đánh giá điểm dừng (Definition of Done).</div></div>
      </div>
    </div>

    <!-- NODE 8 -->
    <div class="node" id="n8" style="left: 11500px; top: 2000px; transform: translateZ(-50px) rotateY(0deg);">
      <div class="ui-glass-card">
        <div class="n-num" style="background: var(--c-magenta); box-shadow: 0 0 60px rgba(255,0,122,0.6);">08</div>
        <div class="gc-sub" style="color: var(--c-magenta);">HOÀN TẤT MỤC TIÊU</div>
        <div class="gc-title">CỘNG SỰ TỰ CHỦ</div>
        <div class="gc-col"><div class="gc-col-desc">Biến AI từ máy trả lời thành phần mềm tự vận hành 2026.</div></div>
      </div>
    </div>

  </div>

  <div class="progress-container"><div class="progress-bar" id="p-bar"></div></div>

  <script>
    // Generate Deterministic Stars
    (function generateStars() {
      const bg = document.getElementById("stars");
      let shadows = [];
      let seed = 1;
      function random() {
          let x = Math.sin(seed++) * 10000;
          return x - Math.floor(x);
      }
      for(let i=0; i<400; i++) {
         const x = Math.floor(random() * 14000);
         const y = Math.floor(random() * 4000);
         const r = random();
         const color = r > 0.8 ? 'rgba(255,255,255,0.8)' : (r > 0.4 ? 'rgba(64, 224, 208, 0.5)' : 'rgba(255,255,255,0.2)');
         shadows.push(`${x}px ${y}px ${Math.floor(random()*3+1)}px ${color}`);
      }
      bg.style.boxShadow = shadows.join(',');
    })();

    gsap.registerPlugin(MotionPathPlugin);

    const vars = window.__hyperframes ? window.__hyperframes.getVariables() : {};
    const DURATION = parseFloat(vars.DURATION) || 96;
    document.body.setAttribute('data-duration', DURATION);

    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });

    tl.to("#p-bar", { width: "100%", duration: DURATION, ease: "none" }, 0);

    const nodes = [
      { id: "#n1", startVar: "N1_START", color: "var(--c-cyan)" },
      { id: "#n2", startVar: "N2_START", color: "var(--c-purple)", path: "#p1" },
      { id: "#n3", startVar: "N3_START", color: "var(--c-yellow)", path: "#p2" },
      { id: "#n4", startVar: "N4_START", color: "var(--c-magenta)", path: "#p3" },
      { id: "#n5", startVar: "N5_START", color: "var(--c-cyan)", path: "#p4" },
      { id: "#n6", startVar: "N6_START", color: "var(--c-purple)", path: "#p5" },
      { id: "#n7", startVar: "N7_START", color: "var(--c-yellow)", path: "#p6" },
      { id: "#n8", startVar: "N8_START", color: "var(--c-magenta)", path: "#p7" }
    ];

    gsap.set("#tracker", { x: 1000, y: 1500 });
    
    // Ambient Motion (Diamond rotation)
    const ambientRepeats = Math.max(0, Math.floor(DURATION / 6) - 1);
    tl.to(".path-diamond", { rotation: "+=180", transformOrigin: "center", duration: 6, repeat: ambientRepeats, ease: "none" }, 0);
    tl.to(".logo-watermark", { opacity: 0.1, duration: 3, repeat: ambientRepeats * 2, yoyo: true, ease: "sine.inOut" }, 0);

    // 3D Camera Pan
    const camera = document.getElementById("camera-container");
    const parallax = document.getElementById("stars");
    
    function updateCamera() {
      const tx = gsap.getProperty("#tracker", "x");
      const ty = gsap.getProperty("#tracker", "y");
      
      // Calculate 3D rotations based on tracker position
      const rotY = (tx - 6500) * 0.002; // Twist as it moves right
      const rotX = (ty - 1600) * 0.01;  // Twist as it moves up/down
      
      const camX = 540 - tx;
      const camY = 960 - ty;
      
      // Apply 3D transforms to the camera container
      gsap.set(camera, { 
        x: camX, 
        y: camY,
        rotationY: -rotY, // Counter-rotate the camera to look AT the node
        rotationX: -rotX,
        z: 400 // Zoom in slightly
      });
      
      gsap.set(parallax, { x: camX * 0.2, y: camY * 0.2 });
    }

    nodes.forEach((node, idx) => {
      const startTime = parseFloat(vars[node.startVar]) || (idx * 10);
      document.querySelector(node.id).setAttribute('data-start', startTime - 1);
      
      // Animations
      const mainSelector = idx === 0 ? ".n1-num" : ".n-num";
      tl.from(`${node.id} ${mainSelector}`, { scale: 0, duration: 1.5, ease: "elastic.out(1, 0.5)" }, startTime - 0.5);
      
      // Animate the actual node content
      tl.from(`${node.id} > div:not(${mainSelector})`, { y: 100, opacity: 0, rotationX: 20, duration: 1.5, ease: "power4.out" }, startTime);
      
      tl.to("#tracker", { background: node.color, boxShadow: `0 0 80px 30px ${node.color}`, duration: 0.5 }, startTime - 0.5);
      
      if (idx > 0) {
        const transDuration = 2.5;
        // SVG paths are deleted by user, so motionPath fails.
        // tl.to("#tracker", {
        //   motionPath: { path: node.path, align: node.path, alignOrigin: [0.5, 0.5] },
        //   duration: transDuration,
        //   ease: "power2.inOut"
        // }, startTime - transDuration);
      }
    });

    tl.eventCallback("onUpdate", updateCamera);
    window.__timelines["main"] = tl;
  </script>
</body>
</html>
