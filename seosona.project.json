{
  "$schema": "~/.seosona/1_CONFIG/schemas/seosona.project.schema.json",
  "schema": "seosona.project.v1",
  "name": "seosona-video",
  "displayName": "SEOSONA Video Factory",
  "domain": "video-production",
  "stack": [
    "python",
    "ffmpeg",
    "whisper",
    "vieneu",
    "hyperframes"
  ],
  "osRoot": "~/.seosona",
  "memoryNamespace": "seosona-video",
  "autonomy": {
    "defaultLevel": "project_edit",
    "requiresExplicitApproval": [
      "os_core_patch",
      "git_publish",
      "deploy"
    ]
  },
  "commands": {
    "intake": "npm run seosona:route --",
    "doctor": "npm run seosona:doctor",
    "manifest": "npm run seosona:manifest",
    "audit": "npm run seosona:audit",
    "run": "npm run video:run --",
    "lint": "python -m flake8 .",
    "typecheck": "python -m flake8 .",
    "build": "npm run seosona:manifest"
  },
  "workflows": [
    "autonomous-capability-activation",
    "project-doctor",
    "portable-rule-sync",
    "project-memory-logging"
  ],
  "ruleFiles": [
    "AGENTS.md",
    ".clauderules",
    ".cursorrules"
  ]
}
